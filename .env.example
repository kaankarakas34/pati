# Browser-safe Supabase values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Supabase values
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_key
DATABASE_URL=postgresql://user:password@pooler-host:5432/postgres?sslmode=require
# Optional PEM CA bundle for a remote database with a private certificate authority.
DATABASE_SSL_CA_FILE=
# Local Docker database password; choose a unique random value before starting Compose.
POSTGRES_PASSWORD=
# Required only for the migration script. No embedded default credentials.
SOURCE_DATABASE_URL=

# Express admin authentication
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_TOKEN=
# Runtime login must inherit pati_api and must not own application tables.
# Migration credentials are separate and are never bundled in the browser.
MIGRATION_DATABASE_URL=
DATABASE_POOL_MAX=3
# Dedicated random HMAC secret for durable submission rate limits.
SUBMISSION_HASH_SECRET=
# Used only by read-only EXPLAIN/preflight and explicit offline maintenance.
AUDIT_DATABASE_URL=
MAINTENANCE_DATABASE_URL=
# Explicit offline import and static sitemap publishing
IMPORT_DATABASE_URL=
SITEMAP_DATABASE_URL=
SITE_URL=https://www.patiyleseyahat.com
