{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "patiyleseyahat.com"
        }
      ],
      "destination": "https://patili.co/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.patiyleseyahat.com"
        }
      ],
      "destination": "https://patili.co/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.patili.co"
        }
      ],
      "destination": "https://patili.co/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/otel/:path*",
      "destination": "/api/index?__path=/otel/:path*"
    },
    {
      "source": "/evcil-hayvan-dostu-oteller/:path*",
      "destination": "/api/index?__path=/evcil-hayvan-dostu-oteller/:path*"
    },
    {
      "source": "/evcil-hayvan-dostu-oteller",
      "destination": "/api/index?__path=/evcil-hayvan-dostu-oteller"
    },
    {
      "source": "/buyuk-kopek-kabul-eden-oteller/:path*",
      "destination": "/api/index?__path=/buyuk-kopek-kabul-eden-oteller/:path*"
    },
    {
      "source": "/buyuk-kopek-kabul-eden-oteller",
      "destination": "/api/index?__path=/buyuk-kopek-kabul-eden-oteller"
    },
    {
      "source": "/evcil-hayvan-dostu-bungalovlar/:path*",
      "destination": "/api/index?__path=/evcil-hayvan-dostu-bungalovlar/:path*"
    },
