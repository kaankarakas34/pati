    },
    {
      "source": "/gezilecek-yerler",
      "destination": "/api/index?__path=/gezilecek-yerler"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/yonetici",
      "destination": "/api/index"
    },
    {
      "source": "/trust-ads",
      "destination": "/api/index?__path=/trust-ads"
    },
    {
      "source": "/:path*",
      "destination": "/api/index?__path=/:path*"
    }
  ]
}
