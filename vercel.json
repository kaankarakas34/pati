{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/otel/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/evcil-hayvan-dostu-oteller/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/evcil-hayvan-dostu-oteller",
      "destination": "/api/index"
    },
    {
      "source": "/kedi-kopek-otelleri",
      "destination": "/api/index"
    },
    {
      "source": "/pet-taksi",
      "destination": "/api/index"
    },
    {
      "source": "/veterinerler",
      "destination": "/api/index"
    },
    {
      "source": "/evcil-hayvanla-gezilecek-yerler",
      "destination": "/api/index"
    },
    {
      "source": "/evcil-hayvan-seyahat-rehberi",
      "destination": "/api/index"
    },
    {
      "source": "/accommodations",
      "destination": "/api/index"
    },
    {
      "source": "/boardings",
      "destination": "/api/index"
    },
    {
      "source": "/guides",
      "destination": "/api/index"
    },
    {
      "source": "/gezilecek-yerler",
      "destination": "/api/index"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index"
    },
    {
      "source": "/yonetici",
      "destination": "/api/index"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
